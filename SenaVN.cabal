cabal-version: 3.0
name: SenaVN
version:
  2.0.0

homepage:
  https://github.com/biyuehu/vn-cli

license:
  GPL-3.0-only

author:
  ArimuraSena

maintainer: biyuehuya@gmail.com
build-type: Simple
extra-doc-files:
  CHANGELOG.md

common shared-properties
  ghc-options: -Wall
  default-language: GHC2021
  default-extensions:
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    OverloadedRecordDot
    OverloadedStrings

  build-depends:
    aeson,
    aeson-pretty,
    base ^>=4.19,
    brick,
    bytestring,
    containers,
    directory,
    filepath,
    haskeline,
    mtl,
    optparse-applicative,
    prettyprinter,
    prettyprinter-ansi-terminal,
    process,
    random,
    req,
    sqlite-simple,
    temporary,
    text,
    time,
    transformers,
    vty,
    vty-crossplatform,

library
  import: shared-properties
  hs-source-dirs: src
  exposed-modules:
    SenaVN
    SenaVN.Api
    SenaVN.Command
    SenaVN.ConsoleSize
    SenaVN.Core
    SenaVN.DB
    SenaVN.Error
    SenaVN.Handler
    SenaVN.Handler.Common
    SenaVN.Handler.Config
    SenaVN.Handler.Game
    SenaVN.Handler.Query
    SenaVN.Handler.Run
    SenaVN.Handler.Sync
    SenaVN.Interactive
    SenaVN.Pretty
    SenaVN.Session
    SenaVN.Stats
    SenaVN.Sync
    SenaVN.System
    SenaVN.TUI
    SenaVN.Types
    SenaVN.Utils
    SenaVN.Version
  other-modules:
    Paths_SenaVN
  autogen-modules:
    Paths_SenaVN

executable SenaVN
  import: shared-properties
  main-is: Main.hs
  hs-source-dirs: app
  ghc-options: -threaded
  build-depends: SenaVN

test-suite spec
  import: shared-properties
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    Test.ConfigSpec
    Test.DBSpec
    Test.Framework
    Test.StatsSpec
    Test.SyncSpec
    Test.TypesSpec
    Test.UtilsSpec
  hs-source-dirs: test
  ghc-options: -threaded
  build-depends: SenaVN
